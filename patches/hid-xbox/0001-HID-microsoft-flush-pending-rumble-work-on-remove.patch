From 1a660c2d0e244f4d5e89b110d62cf9534b818eab Mon Sep 17 00:00:00 2001
From: Ken <kvandine@gmail.com>
Date: Fri, 20 Nov 2026 03:21:53 +0000
Subject: [PATCH 1/4] HID: microsoft: flush pending rumble work on remove

ms_play_effect() queues ms->ff_worker on the system workqueue, but
ms_remove() never waits for it. If a rumble update is still pending when
an Xbox controller disconnects, the worker can run after devres has
freed both struct ms_data and the output report buffer it writes to.

Initialise the work item in ms_probe() so it is valid for every device
bound to the driver, and cancel it after hid_hw_stop(). By then the
input device has been unregistered and ml_ff_stop() has shut down the
ff-memless timer, so nothing can re-queue the work.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01N6AAHtchJS5gBMxR7F1sf8
---
 drivers/hid/hid-microsoft.c | 16 +++++++++++++---
 1 file changed, 13 insertions(+), 3 deletions(-)

diff --git a/drivers/hid/hid-microsoft.c b/drivers/hid/hid-microsoft.c
index a7d3493a6..9ebb1a885 100644
--- a/drivers/hid/hid-microsoft.c
+++ b/drivers/hid/hid-microsoft.c
@@ -334,9 +334,6 @@ static int ms_input_configured(struct hid_device *hdev, struct hid_input *hidinp
 	if (!list_is_first(&hidinput->list, &hdev->inputs))
 		return 0;
 
-	ms->hdev = hdev;
-	INIT_WORK(&ms->ff_worker, ms_ff_worker);
-
 	ms->output_report_dmabuf = devm_kzalloc(&hdev->dev,
 						sizeof(struct xb1s_ff_report),
 						GFP_KERNEL);
@@ -358,6 +355,8 @@ static int ms_probe(struct hid_device *hdev, const struct hid_device_id *id)
 		return -ENOMEM;
 
 	ms->quirks = quirks;
+	ms->hdev = hdev;
+	INIT_WORK(&ms->ff_worker, ms_ff_worker);
 
 	hid_set_drvdata(hdev, ms);
 
@@ -382,9 +381,20 @@ static int ms_probe(struct hid_device *hdev, const struct hid_device_id *id)
 
 	return 0;
 }
+
 static void ms_remove(struct hid_device *hdev)
 {
+	struct ms_data *ms = hid_get_drvdata(hdev);
+
 	hid_hw_stop(hdev);
+
+	/*
+	 * hid_hw_stop() tears down the input device and with it the
+	 * ff-memless timer, so no new rumble work can be queued past
+	 * this point. Flush anything still pending before devres frees
+	 * ms and the output report buffer.
+	 */
+	cancel_work_sync(&ms->ff_worker);
 }
 
 static const struct hid_device_id ms_devices[] = {
