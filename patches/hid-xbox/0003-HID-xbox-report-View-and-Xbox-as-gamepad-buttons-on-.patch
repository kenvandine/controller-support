From 04e28dbbaa5c19dd43262da886172494aee03744 Mon Sep 17 00:00:00 2001
From: Ken <kvandine@gmail.com>
Date: Fri, 20 Nov 2026 15:53:33 +0000
Subject: [PATCH 3/4] HID: xbox: report View and Xbox as gamepad buttons on
 classic firmware

The same Xbox One S controller (model 1708) announces two different
report descriptors depending on its firmware:

 - Bluetooth Classic firmware (PID 0x02fd, 334-byte descriptor) declares
   Button 1-15 in the gamepad block but reports View as Consumer AC Back
   in report 1 and Xbox as Consumer AC Home in a separate report 2. The
   Button 11 and 13 bits are never set.
 - BLE firmware (PID 0x0b20, 283-byte descriptor) drops both consumer
   usages and reports View and Xbox as Button 11 and 13.

hid-input therefore turns View/Xbox into KEY_BACK/KEY_HOMEPAGE on
classic firmware and into BTN_SELECT/BTN_MODE on BLE firmware, and the
classic device also advertises BTN_SELECT/BTN_MODE that can never fire.

Detect the classic layout from the parsed descriptor (an AC Back usage
in an input report) rather than from the product ID or firmware
version, and map AC Back to BTN_SELECT and AC Home to BTN_MODE while
ignoring the dead Button 11 and 13 usages. Both firmwares now report
these buttons as Documentation/input/gamepad.rst describes.

Relevant part of the classic descriptor (fw 0x0903):

  05 0c 0a 24 02 15 00 25 01 95 01 75 01 81 02   AC Back, report 1
  ...
  05 0c 09 01 85 02 a1 01 05 0c 0a 23 02 ...     AC Home, report 2

Both layouts were captured on the same physical controller before and
after a firmware update.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01N6AAHtchJS5gBMxR7F1sf8
---
 drivers/hid/hid-xbox.c | 59 ++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 59 insertions(+)

diff --git a/drivers/hid/hid-xbox.c b/drivers/hid/hid-xbox.c
index c83ea1ea4..9a71a4b41 100644
--- a/drivers/hid/hid-xbox.c
+++ b/drivers/hid/hid-xbox.c
@@ -42,14 +42,69 @@ struct xbox_ff_report {
 	u8 loop_count;
 } __packed;
 
+/*
+ * Older (Bluetooth Classic) firmware reports View and Xbox as Consumer
+ * AC Back and AC Home, while the gamepad button block declares Button 11
+ * and 13 for them but never sets those bits. Newer (BLE) firmware drops
+ * the consumer usages and uses the buttons. The quirk is keyed on the
+ * descriptor, not the product ID or firmware version, so it follows
+ * whatever layout the controller actually announces.
+ */
+#define XBOX_QUIRK_CONSUMER_BUTTONS	BIT(0)
+
 struct xbox_device {
 	struct hid_device *hdev;
+	unsigned long quirks;
 	struct work_struct ff_worker;
 	u8 strong;
 	u8 weak;
 	struct xbox_ff_report *ff_report;
 };
 
+static bool xbox_has_input_usage(struct hid_device *hdev, u32 usage_hid)
+{
+	struct hid_report_enum *re = &hdev->report_enum[HID_INPUT_REPORT];
+	struct hid_report *report;
+	struct hid_field *field;
+	unsigned int i, j;
+
+	list_for_each_entry(report, &re->report_list, list) {
+		for (i = 0; i < report->maxfield; i++) {
+			field = report->field[i];
+			for (j = 0; j < field->maxusage; j++)
+				if (field->usage[j].hid == usage_hid)
+					return true;
+		}
+	}
+
+	return false;
+}
+
+static int xbox_input_mapping(struct hid_device *hdev, struct hid_input *hi,
+			      struct hid_field *field, struct hid_usage *usage,
+			      unsigned long **bit, int *max)
+{
+	struct xbox_device *xdev = hid_get_drvdata(hdev);
+
+	if (!(xdev->quirks & XBOX_QUIRK_CONSUMER_BUTTONS))
+		return 0;
+
+	switch (usage->hid) {
+	case HID_UP_BUTTON | 11:
+	case HID_UP_BUTTON | 13:
+		/* Declared but never sent; see XBOX_QUIRK_CONSUMER_BUTTONS. */
+		return -1;
+	case HID_UP_CONSUMER | 0x224:	/* AC Back: View */
+		hid_map_usage_clear(hi, usage, bit, max, EV_KEY, BTN_SELECT);
+		return 1;
+	case HID_UP_CONSUMER | 0x223:	/* AC Home: Xbox */
+		hid_map_usage_clear(hi, usage, bit, max, EV_KEY, BTN_MODE);
+		return 1;
+	}
+
+	return 0;
+}
+
 static void xbox_ff_worker(struct work_struct *work)
 {
 	struct xbox_device *xdev = container_of(work, struct xbox_device,
@@ -130,6 +185,9 @@ static int xbox_probe(struct hid_device *hdev, const struct hid_device_id *id)
 		return ret;
 	}
 
+	if (xbox_has_input_usage(hdev, HID_UP_CONSUMER | 0x224))
+		xdev->quirks |= XBOX_QUIRK_CONSUMER_BUTTONS;
+
 	ret = hid_hw_start(hdev, HID_CONNECT_DEFAULT);
 	if (ret) {
 		hid_err(hdev, "hw start failed\n");
@@ -173,6 +231,7 @@ MODULE_DEVICE_TABLE(hid, xbox_devices);
 static struct hid_driver xbox_driver = {
 	.name = "xbox",
 	.id_table = xbox_devices,
+	.input_mapping = xbox_input_mapping,
 	.input_configured = xbox_input_configured,
 	.probe = xbox_probe,
 	.remove = xbox_remove,
-- 
