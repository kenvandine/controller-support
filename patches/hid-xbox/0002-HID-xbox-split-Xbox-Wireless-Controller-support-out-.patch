diff --git a/drivers/hid/hid-xbox.c b/drivers/hid/hid-xbox.c
new file mode 100644
index 000000000..c83ea1ea4
--- /dev/null
+++ b/drivers/hid/hid-xbox.c
@@ -0,0 +1,183 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * HID driver for Xbox Wireless Controllers connected over Bluetooth
+ *
+ * Xbox One S (model 1708), Xbox Series X|S (model 1914) and Xbox Elite
+ * Series 2 (model 1797) controllers, plus the 8BitDo SN30 Pro+ in its
+ * Xbox-compatible mode, expose a regular HID gamepad over Bluetooth with a
+ * vendor output report for rumble. This support previously lived in
+ * hid-microsoft; it is kept separate so controller-specific handling can
+ * grow without touching the keyboard, mouse and presenter quirks there.
+ *
+ * Copyright (c) 1999 Andreas Gal
+ * Copyright (c) 2000-2005 Vojtech Pavlik <vojtech@suse.cz>
+ * Copyright (c) 2006-2007 Jiri Kosina
+ * Copyright (c) 2008 Jiri Slaby
+ */
+
+#include <linux/device.h>
+#include <linux/hid.h>
+#include <linux/input.h>
+#include <linux/module.h>
+#include <linux/workqueue.h>
+
+#include "hid-ids.h"
+
+#define XBOX_FF_REPORT		3
+#define XBOX_FF_ENABLE_WEAK	BIT(0)
+#define XBOX_FF_ENABLE_STRONG	BIT(1)
+
+enum {
+	XBOX_FF_MAGNITUDE_STRONG = 2,
+	XBOX_FF_MAGNITUDE_WEAK,
+	XBOX_FF_MAGNITUDE_NUM
+};
+
+struct xbox_ff_report {
+	u8 report_id;
+	u8 enable;
+	u8 magnitude[XBOX_FF_MAGNITUDE_NUM];
+	u8 duration_10ms;
+	u8 start_delay_10ms;
+	u8 loop_count;
+} __packed;
+
+struct xbox_device {
+	struct hid_device *hdev;
+	struct work_struct ff_worker;
+	u8 strong;
+	u8 weak;
+	struct xbox_ff_report *ff_report;
+};
+
+static void xbox_ff_worker(struct work_struct *work)
+{
+	struct xbox_device *xdev = container_of(work, struct xbox_device,
+						ff_worker);
+	struct xbox_ff_report *r = xdev->ff_report;
+	int ret;
+
+	memset(r, 0, sizeof(*r));
+
+	r->report_id = XBOX_FF_REPORT;
+	r->enable = XBOX_FF_ENABLE_WEAK | XBOX_FF_ENABLE_STRONG;
+	/*
+	 * Specifying maximum duration and maximum loop count should cover
+	 * the maximum duration of a single effect, which is 65536 ms.
+	 */
+	r->duration_10ms = U8_MAX;
+	r->loop_count = U8_MAX;
+	r->magnitude[XBOX_FF_MAGNITUDE_STRONG] = xdev->strong; /* left */
+	r->magnitude[XBOX_FF_MAGNITUDE_WEAK] = xdev->weak;     /* right */
+
+	ret = hid_hw_output_report(xdev->hdev, (u8 *)r, sizeof(*r));
+	if (ret < 0)
+		hid_warn(xdev->hdev, "failed to send FF report\n");
+}
+
+static int xbox_play_effect(struct input_dev *dev, void *data,
+			    struct ff_effect *effect)
+{
+	struct hid_device *hdev = input_get_drvdata(dev);
+	struct xbox_device *xdev = hid_get_drvdata(hdev);
+
+	if (effect->type != FF_RUMBLE)
+		return 0;
+
+	/* The controller takes 0..100, so scale the 16-bit magnitudes. */
+	xdev->strong = ((u32)effect->u.rumble.strong_magnitude * 100) / U16_MAX;
+	xdev->weak = ((u32)effect->u.rumble.weak_magnitude * 100) / U16_MAX;
+
+	schedule_work(&xdev->ff_worker);
+	return 0;
+}
+
+static int xbox_input_configured(struct hid_device *hdev,
+				 struct hid_input *hidinput)
+{
+	struct xbox_device *xdev = hid_get_drvdata(hdev);
+	struct input_dev *input = hidinput->input;
+
+	/* Rumble is only attached to the first (gamepad) input. */
+	if (!list_is_first(&hidinput->list, &hdev->inputs))
+		return 0;
+
+	xdev->ff_report = devm_kzalloc(&hdev->dev, sizeof(*xdev->ff_report),
+				       GFP_KERNEL);
+	if (!xdev->ff_report)
+		return -ENOMEM;
+
+	input_set_capability(input, EV_FF, FF_RUMBLE);
+	return input_ff_create_memless(input, NULL, xbox_play_effect);
+}
+
+static int xbox_probe(struct hid_device *hdev, const struct hid_device_id *id)
+{
+	struct xbox_device *xdev;
+	int ret;
+
+	xdev = devm_kzalloc(&hdev->dev, sizeof(*xdev), GFP_KERNEL);
+	if (!xdev)
+		return -ENOMEM;
+
+	xdev->hdev = hdev;
+	INIT_WORK(&xdev->ff_worker, xbox_ff_worker);
+	hid_set_drvdata(hdev, xdev);
+
+	ret = hid_parse(hdev);
+	if (ret) {
+		hid_err(hdev, "parse failed\n");
+		return ret;
+	}
+
+	ret = hid_hw_start(hdev, HID_CONNECT_DEFAULT);
+	if (ret) {
+		hid_err(hdev, "hw start failed\n");
+		return ret;
+	}
+
+	return 0;
+}
+
+static void xbox_remove(struct hid_device *hdev)
+{
+	struct xbox_device *xdev = hid_get_drvdata(hdev);
+
+	hid_hw_stop(hdev);
+
+	/*
+	 * hid_hw_stop() tears down the input device and with it the
+	 * ff-memless timer, so no new rumble work can be queued past this
+	 * point. Flush anything still pending before devres frees xdev.
+	 */
+	cancel_work_sync(&xdev->ff_worker);
+}
+
+static const struct hid_device_id xbox_devices[] = {
+	{ HID_BLUETOOTH_DEVICE(USB_VENDOR_ID_MICROSOFT,
+			       USB_DEVICE_ID_MS_XBOX_CONTROLLER_MODEL_1708) },
+	{ HID_BLUETOOTH_DEVICE(USB_VENDOR_ID_MICROSOFT,
+			       USB_DEVICE_ID_MS_XBOX_CONTROLLER_MODEL_1708_BLE) },
+	{ HID_BLUETOOTH_DEVICE(USB_VENDOR_ID_MICROSOFT,
+			       USB_DEVICE_ID_MS_XBOX_CONTROLLER_MODEL_1914) },
+	{ HID_BLUETOOTH_DEVICE(USB_VENDOR_ID_MICROSOFT,
+			       USB_DEVICE_ID_MS_XBOX_CONTROLLER_MODEL_1797) },
+	{ HID_BLUETOOTH_DEVICE(USB_VENDOR_ID_MICROSOFT,
+			       USB_DEVICE_ID_MS_XBOX_CONTROLLER_MODEL_1797_BLE) },
+	{ HID_BLUETOOTH_DEVICE(USB_VENDOR_ID_MICROSOFT,
+			       USB_DEVICE_ID_8BITDO_SN30_PRO_PLUS) },
+	{ }
+};
+MODULE_DEVICE_TABLE(hid, xbox_devices);
+
+static struct hid_driver xbox_driver = {
+	.name = "xbox",
+	.id_table = xbox_devices,
+	.input_configured = xbox_input_configured,
+	.probe = xbox_probe,
+	.remove = xbox_remove,
+};
+module_hid_driver(xbox_driver);
+
+MODULE_DESCRIPTION("HID driver for Xbox Wireless Controllers over Bluetooth");
+MODULE_LICENSE("GPL");
