 	tristate "Microsoft non-fully HID-compliant devices"
-	select INPUT_FF_MEMLESS
 	help
 	Support for Microsoft devices that are not fully compliant with HID standard.
 
+	Xbox Wireless Controllers connected over Bluetooth are handled by
+	HID_XBOX.
+
 config HID_MONTEREY
 	tristate "Monterey Genius KB29E keyboard"
 	help
@@ -1415,6 +1417,28 @@ config HID_WINWING
 	  To compile this driver as a module, choose M here: the
 	  module will be called hid-winwing.
 
+config HID_XBOX
+	tristate "Xbox Wireless Controller over Bluetooth"
+	default HID_MICROSOFT
+	select INPUT_FF_MEMLESS
+	help
+	  Support for Xbox Wireless Controllers connected over Bluetooth,
+	  including rumble. Supported devices:
+
+	    * Xbox One S Controller (model 1708)
+	    * Xbox Series X|S Controller (model 1914)
+	    * Xbox Elite Wireless Controller Series 2 (model 1797)
+	    * 8BitDo SN30 Pro+ in Xbox mode
+
+	  USB and Xbox Wireless Adapter connections are handled by the xpad
+	  driver instead.
+
+	  This support used to be part of HID_MICROSOFT and defaults to the
+	  same setting.
+
+	  To compile this driver as a module, choose M here: the
+	  module will be called hid-xbox.
+
 config HID_XINMO
 	tristate "Xin-Mo non-fully compliant devices"
 	help
