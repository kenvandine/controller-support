+#!/bin/env python3
+# SPDX-License-Identifier: GPL-2.0
+# -*- coding: utf-8 -*-
+#
+# Xbox Wireless Controller (model 1708) over Bluetooth, handled by
+# hid-microsoft. The same controller announces a different report
+# descriptor depending on its firmware, and both layouts must give
+# userspace working View (BTN_SELECT) and Xbox (BTN_MODE) buttons.
+
+from . import base
+from .base import KernelModule
+from hidtools.util import BusType
+
+import libevdev
+import logging
+
+logger = logging.getLogger("hidtools.test.xbox_bluetooth")
+
+MS_MODULE = KernelModule("microsoft", "hid_microsoft")
+
+# Bluetooth Classic firmware (0x0903), PID 0x02fd: View is Consumer AC Back
+# in report 1, Xbox is Consumer AC Home alone in report 2.
