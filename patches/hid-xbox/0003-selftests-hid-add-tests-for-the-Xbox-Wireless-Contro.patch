+
+# BLE firmware (5.23), PID 0x0b20: View and Xbox are Button 11 and 13, and
+# the last bit of report 1 is Consumer Record.
+XBOX_1708_BLE_RDESC = [
+    0x05, 0x01, 0x09, 0x05, 0xa1, 0x01, 0x85, 0x01, 0x09, 0x01, 0xa1, 0x00,
+    0x09, 0x30, 0x09, 0x31, 0x15, 0x00, 0x27, 0xff, 0xff, 0x00, 0x00, 0x95,
+    0x02, 0x75, 0x10, 0x81, 0x02, 0xc0, 0x09, 0x01, 0xa1, 0x00, 0x09, 0x32,
+    0x09, 0x35, 0x15, 0x00, 0x27, 0xff, 0xff, 0x00, 0x00, 0x95, 0x02, 0x75,
+    0x10, 0x81, 0x02, 0xc0, 0x05, 0x02, 0x09, 0xc5, 0x15, 0x00, 0x26, 0xff,
+    0x03, 0x95, 0x01, 0x75, 0x0a, 0x81, 0x02, 0x15, 0x00, 0x25, 0x00, 0x75,
+    0x06, 0x95, 0x01, 0x81, 0x03, 0x05, 0x02, 0x09, 0xc4, 0x15, 0x00, 0x26,
+    0xff, 0x03, 0x95, 0x01, 0x75, 0x0a, 0x81, 0x02, 0x15, 0x00, 0x25, 0x00,
+    0x75, 0x06, 0x95, 0x01, 0x81, 0x03, 0x05, 0x01, 0x09, 0x39, 0x15, 0x01,
+    0x25, 0x08, 0x35, 0x00, 0x46, 0x3b, 0x01, 0x66, 0x14, 0x00, 0x75, 0x04,
+    0x95, 0x01, 0x81, 0x42, 0x75, 0x04, 0x95, 0x01, 0x15, 0x00, 0x25, 0x00,
+    0x35, 0x00, 0x45, 0x00, 0x65, 0x00, 0x81, 0x03, 0x05, 0x09, 0x19, 0x01,
+    0x29, 0x0f, 0x15, 0x00, 0x25, 0x01, 0x75, 0x01, 0x95, 0x0f, 0x81, 0x02,
+    0x15, 0x00, 0x25, 0x00, 0x75, 0x01, 0x95, 0x01, 0x81, 0x03, 0x05, 0x0c,
+    0x0a, 0xb2, 0x00, 0x15, 0x00, 0x25, 0x01, 0x95, 0x01, 0x75, 0x01, 0x81,
+    0x02, 0x15, 0x00, 0x25, 0x00, 0x75, 0x07, 0x95, 0x01, 0x81, 0x03, 0x05,
+    0x0f, 0x09, 0x21, 0x85, 0x03, 0xa1, 0x02, 0x09, 0x97, 0x15, 0x00, 0x25,
+    0x01, 0x75, 0x04, 0x95, 0x01, 0x91, 0x02, 0x15, 0x00, 0x25, 0x00, 0x75,
+    0x04, 0x95, 0x01, 0x91, 0x03, 0x09, 0x70, 0x15, 0x00, 0x25, 0x64, 0x75,
+    0x08, 0x95, 0x04, 0x91, 0x02, 0x09, 0x50, 0x66, 0x01, 0x10, 0x55, 0x0e,
+    0x15, 0x00, 0x26, 0xff, 0x00, 0x75, 0x08, 0x95, 0x01, 0x91, 0x02, 0x09,
+    0xa7, 0x15, 0x00, 0x26, 0xff, 0x00, 0x75, 0x08, 0x95, 0x01, 0x91, 0x02,
+    0x65, 0x00, 0x55, 0x00, 0x09, 0x7c, 0x15, 0x00, 0x26, 0xff, 0x00, 0x75,
+    0x08, 0x95, 0x01, 0x91, 0x02, 0xc0, 0xc0,
+]
+
+# Bits in the 16-bit button field of report 1 (Button N is bit N - 1)
+BUTTON_A = 1 << 0
+BUTTON_VIEW_BLE = 1 << 10
+BUTTON_MENU = 1 << 11
+BUTTON_XBOX_BLE = 1 << 12
+
+
+class XboxBluetoothController(base.UHIDTestDevice):
+    def __init__(self, rdesc, product, name):
+        super().__init__(
+            name,
+            "Game Pad",
+            rdesc=rdesc,
+            input_info=(BusType.BLUETOOTH, 0x045E, product),
+        )
+
+    def report1(self, buttons=0, consumer=False):
+        """Report 1 with centred sticks, released triggers and a null hat."""
+        r = [0x01]
+        r += [0x00, 0x80] * 4  # X, Y, Z, Rz
+        r += [0x00, 0x00] * 2  # Brake, Accelerator
+        r += [0x00]  # hat
+        r += [buttons & 0xFF, (buttons >> 8) & 0x7F]
+        r += [0x01 if consumer else 0x00]
+        self.call_input_event(r)
+        return [r]
+
+
+class XboxClassicController(XboxBluetoothController):
+    def __init__(self, name=None):
+        super().__init__(XBOX_1708_CLASSIC_RDESC, 0x02FD, name)
+
+    def report2(self, home):
+        r = [0x02, 0x01 if home else 0x00]
+        self.call_input_event(r)
+        return [r]
+
+
+class XboxBLEController(XboxBluetoothController):
+    def __init__(self, name=None):
+        super().__init__(XBOX_1708_BLE_RDESC, 0x0B20, name)
+
+
+def key_events(events):
+    return [e for e in events if e.matches(libevdev.EV_KEY)]
+
+
+class BaseTest:
+    class XboxTest(base.BaseTestCase.TestUhid):
+        kernel_modules = [MS_MODULE]
+
+        def press(self, send, *args):
+            uhdev = self.uhdev
+            r = send(*args)
+            events = uhdev.next_sync_events()
+            self.debug_reports(r, uhdev, events)
+            return key_events(events)
+
+        def test_menu(self):
+            """Menu is Button 12 on every firmware."""
+            uhdev = self.uhdev
+            evdev = uhdev.get_evdev()
+
+            events = self.press(uhdev.report1, BUTTON_MENU)
+            assert libevdev.InputEvent(libevdev.EV_KEY.BTN_START, 1) in events
+            assert evdev.value[libevdev.EV_KEY.BTN_START] == 1
+
+            events = self.press(uhdev.report1, 0)
+            assert libevdev.InputEvent(libevdev.EV_KEY.BTN_START, 0) in events
+            assert evdev.value[libevdev.EV_KEY.BTN_START] == 0
+
+
+class TestXboxClassic(BaseTest.XboxTest):
+    def create_device(self):
+        return XboxClassicController()
+
+    def test_advertised_codes(self):
+        """The old keys stay advertised next to the gamepad buttons, so
+        userspace that numbers buttons from the advertised codes keeps
+        the same indices."""
+        evdev = self.uhdev.get_evdev()
+        for code in (
+            libevdev.EV_KEY.KEY_BACK,
+            libevdev.EV_KEY.KEY_HOMEPAGE,
+            libevdev.EV_KEY.BTN_SELECT,
+            libevdev.EV_KEY.BTN_MODE,
+        ):
+            assert evdev.has(code)
+
+    def test_view(self):
+        """AC Back drives both KEY_BACK and BTN_SELECT."""
+        uhdev = self.uhdev
+        evdev = uhdev.get_evdev()
+
+        events = self.press(uhdev.report1, 0, True)
+        assert libevdev.InputEvent(libevdev.EV_KEY.KEY_BACK, 1) in events
+        assert libevdev.InputEvent(libevdev.EV_KEY.BTN_SELECT, 1) in events
+
+        # holding it must not release BTN_SELECT through Button 11
+        events = self.press(uhdev.report1, BUTTON_A, True)
+        assert libevdev.InputEvent(libevdev.EV_KEY.BTN_SELECT, 0) not in events
+        assert evdev.value[libevdev.EV_KEY.BTN_SELECT] == 1
+        assert evdev.value[libevdev.EV_KEY.KEY_BACK] == 1
+
+        events = self.press(uhdev.report1, 0, False)
+        assert libevdev.InputEvent(libevdev.EV_KEY.KEY_BACK, 0) in events
+        assert libevdev.InputEvent(libevdev.EV_KEY.BTN_SELECT, 0) in events
+
+    def test_xbox(self):
+        """AC Home in report 2 drives both KEY_HOMEPAGE and BTN_MODE."""
+        uhdev = self.uhdev
+        evdev = uhdev.get_evdev()
+
+        events = self.press(uhdev.report2, True)
+        assert libevdev.InputEvent(libevdev.EV_KEY.KEY_HOMEPAGE, 1) in events
+        assert libevdev.InputEvent(libevdev.EV_KEY.BTN_MODE, 1) in events
+
+        # report 1 traffic must not release BTN_MODE through Button 13
+        events = self.press(uhdev.report1, BUTTON_A)
+        assert libevdev.InputEvent(libevdev.EV_KEY.BTN_MODE, 0) not in events
+        assert evdev.value[libevdev.EV_KEY.BTN_MODE] == 1
+
+        events = self.press(uhdev.report2, False)
+        assert libevdev.InputEvent(libevdev.EV_KEY.KEY_HOMEPAGE, 0) in events
+        assert libevdev.InputEvent(libevdev.EV_KEY.BTN_MODE, 0) in events
+
+    def test_unused_button_bits(self):
+        """This firmware never sets Button 11 and 13, so they are ignored."""
+        uhdev = self.uhdev
+
+        events = self.press(uhdev.report1, BUTTON_VIEW_BLE | BUTTON_XBOX_BLE)
+        assert not [e for e in events if e.value == 1]
+
+
+class TestXboxBLE(BaseTest.XboxTest):
+    def create_device(self):
+        return XboxBLEController()
+
+    def test_advertised_codes(self):
+        evdev = self.uhdev.get_evdev()
+        assert evdev.has(libevdev.EV_KEY.BTN_SELECT)
+        assert evdev.has(libevdev.EV_KEY.BTN_MODE)
+        assert not evdev.has(libevdev.EV_KEY.KEY_BACK)
+        assert not evdev.has(libevdev.EV_KEY.KEY_HOMEPAGE)
+
+    def test_view(self):
+        """View is Button 11 and gives BTN_SELECT only."""
+        uhdev = self.uhdev
+
+        events = self.press(uhdev.report1, BUTTON_VIEW_BLE)
+        assert events == [libevdev.InputEvent(libevdev.EV_KEY.BTN_SELECT, 1)]
+
+        events = self.press(uhdev.report1, 0)
+        assert events == [libevdev.InputEvent(libevdev.EV_KEY.BTN_SELECT, 0)]
+
+    def test_xbox(self):
+        """Xbox is Button 13 and gives BTN_MODE only."""
+        uhdev = self.uhdev
+
+        events = self.press(uhdev.report1, BUTTON_XBOX_BLE)
+        assert events == [libevdev.InputEvent(libevdev.EV_KEY.BTN_MODE, 1)]
+
+        events = self.press(uhdev.report1, 0)
+        assert events == [libevdev.InputEvent(libevdev.EV_KEY.BTN_MODE, 0)]
