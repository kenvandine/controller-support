diff --git a/drivers/hid/hid-xbox.c b/drivers/hid/hid-xbox.c
new file mode 100644
index 000000000..1bbf79f55
--- /dev/null
+++ b/drivers/hid/hid-xbox.c
@@ -0,0 +1,270 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * HID driver for Xbox Wireless Controllers connected over Bluetooth
+ *
+ * Xbox One S (model 1708), Xbox Series X|S (model 1914) and Xbox Elite
+ * Series 2 (model 1797) controllers, plus the 8BitDo SN30 Pro+ in its
+ * Xbox-compatible mode, expose a regular HID gamepad over Bluetooth with a
+ * vendor output report for rumble. This support previously lived in
+ * hid-microsoft; it is kept separate so controller-specific handling can
+ * grow without touching the keyboard, mouse and presenter quirks there.
+ *
+ * Copyright (c) 1999 Andreas Gal
+ * Copyright (c) 2000-2005 Vojtech Pavlik <vojtech@suse.cz>
+ * Copyright (c) 2006-2007 Jiri Kosina
+ * Copyright (c) 2008 Jiri Slaby
+ */
+
+#include <linux/device.h>
+#include <linux/hid.h>
+#include <linux/input.h>
+#include <linux/module.h>
+#include <linux/workqueue.h>
+
+#include "hid-ids.h"
+
+#define XBOX_FF_REPORT		3
+/* Minimum time between two rumble output reports. */
+#define XBOX_FF_MIN_INTERVAL_MS	10
+#define XBOX_FF_ENABLE_WEAK	BIT(0)
+#define XBOX_FF_ENABLE_STRONG	BIT(1)
+
+enum {
+	XBOX_FF_MAGNITUDE_STRONG = 2,
+	XBOX_FF_MAGNITUDE_WEAK,
+	XBOX_FF_MAGNITUDE_NUM
+};
+
+struct xbox_ff_report {
+	u8 report_id;
+	u8 enable;
+	u8 magnitude[XBOX_FF_MAGNITUDE_NUM];
+	u8 duration_10ms;
+	u8 start_delay_10ms;
+	u8 loop_count;
+} __packed;
+
+/*
+ * Older (Bluetooth Classic) firmware reports View and Xbox as Consumer
+ * AC Back and AC Home, while the gamepad button block declares Button 11
+ * and 13 for them but never sets those bits. Newer (BLE) firmware drops
+ * the consumer usages and uses the buttons. The quirk is keyed on the
+ * descriptor, not the product ID or firmware version, so it follows
+ * whatever layout the controller actually announces.
+ *
+ * On the classic layout, View and Xbox also drive BTN_SELECT and BTN_MODE.
+ * KEY_BACK and KEY_HOMEPAGE keep being reported, so the set of advertised
+ * codes (and with it the button numbering existing userspace mappings rely
+ * on) does not change.
+ */
+#define XBOX_QUIRK_CONSUMER_BUTTONS	BIT(0)
+
+struct xbox_device {
+	struct hid_device *hdev;
+	unsigned long quirks;
+	struct delayed_work ff_worker;
+	unsigned long ff_next;	/* jiffies: earliest time for the next report */
+	u8 strong;
+	u8 weak;
+	struct xbox_ff_report *ff_report;
+};
+
+static bool xbox_has_input_usage(struct hid_device *hdev, u32 usage_hid)
+{
+	struct hid_report_enum *re = &hdev->report_enum[HID_INPUT_REPORT];
+	struct hid_report *report;
+	struct hid_field *field;
+	unsigned int i, j;
+
+	list_for_each_entry(report, &re->report_list, list) {
+		for (i = 0; i < report->maxfield; i++) {
+			field = report->field[i];
+			for (j = 0; j < field->maxusage; j++)
+				if (field->usage[j].hid == usage_hid)
+					return true;
+		}
+	}
+
+	return false;
+}
+
+static int xbox_event(struct hid_device *hdev, struct hid_field *field,
+		      struct hid_usage *usage, __s32 value)
+{
+	struct xbox_device *xdev = hid_get_drvdata(hdev);
+	struct input_dev *input;
+
+	if (!(xdev->quirks & XBOX_QUIRK_CONSUMER_BUTTONS) ||
+	    !(hdev->claimed & HID_CLAIMED_INPUT) || !field->hidinput)
+		return 0;
+
+	input = field->hidinput->input;
+
+	switch (usage->hid) {
+	case HID_UP_BUTTON | 11:
+	case HID_UP_BUTTON | 13:
+		/* Never set by this firmware; driven from the consumer usages. */
+		return 1;
+	case HID_UP_CONSUMER | 0x224:	/* AC Back: View */
+		input_report_key(input, BTN_SELECT, value);
+		break;
+	case HID_UP_CONSUMER | 0x223:	/* AC Home: Xbox */
+		input_report_key(input, BTN_MODE, value);
+		break;
+	}
+
+	/* Let hid-input report KEY_BACK/KEY_HOMEPAGE as before. */
+	return 0;
+}
+
+static void xbox_ff_worker(struct work_struct *work)
+{
+	struct xbox_device *xdev = container_of(to_delayed_work(work),
+						struct xbox_device, ff_worker);
+	struct xbox_ff_report *r = xdev->ff_report;
+	int ret;
+
+	WRITE_ONCE(xdev->ff_next,
+		   jiffies + msecs_to_jiffies(XBOX_FF_MIN_INTERVAL_MS));
+
+	memset(r, 0, sizeof(*r));
+
+	r->report_id = XBOX_FF_REPORT;
+	r->enable = XBOX_FF_ENABLE_WEAK | XBOX_FF_ENABLE_STRONG;
+	/*
+	 * Specifying maximum duration and maximum loop count should cover
+	 * the maximum duration of a single effect, which is 65536 ms.
+	 */
+	r->duration_10ms = U8_MAX;
+	r->loop_count = U8_MAX;
+	r->magnitude[XBOX_FF_MAGNITUDE_STRONG] = READ_ONCE(xdev->strong); /* left */
+	r->magnitude[XBOX_FF_MAGNITUDE_WEAK] = READ_ONCE(xdev->weak);     /* right */
+
+	ret = hid_hw_output_report(xdev->hdev, (u8 *)r, sizeof(*r));
+	if (ret < 0)
+		hid_warn(xdev->hdev, "failed to send FF report\n");
+}
+
+static int xbox_play_effect(struct input_dev *dev, void *data,
+			    struct ff_effect *effect)
+{
+	struct hid_device *hdev = input_get_drvdata(dev);
+	struct xbox_device *xdev = hid_get_drvdata(hdev);
+	unsigned long next, delay = 0;
+
+	if (effect->type != FF_RUMBLE)
+		return 0;
+
+	/* The controller takes 0..100, so scale the 16-bit magnitudes. */
+	WRITE_ONCE(xdev->strong,
+		   ((u32)effect->u.rumble.strong_magnitude * 100) / U16_MAX);
+	WRITE_ONCE(xdev->weak,
+		   ((u32)effect->u.rumble.weak_magnitude * 100) / U16_MAX);
+
+	/*
+	 * Send at most one report per XBOX_FF_MIN_INTERVAL_MS. If a report
+	 * is already queued this does nothing, and that report picks up the
+	 * values just stored, so the latest magnitudes always win.
+	 */
+	next = READ_ONCE(xdev->ff_next);
+	if (time_before(jiffies, next))
+		delay = min(next - jiffies,
+			    msecs_to_jiffies(XBOX_FF_MIN_INTERVAL_MS));
+	schedule_delayed_work(&xdev->ff_worker, delay);
+	return 0;
+}
+
+static int xbox_input_configured(struct hid_device *hdev,
+				 struct hid_input *hidinput)
+{
+	struct xbox_device *xdev = hid_get_drvdata(hdev);
+	struct input_dev *input = hidinput->input;
+
+	/* Rumble is only attached to the first (gamepad) input. */
+	if (!list_is_first(&hidinput->list, &hdev->inputs))
+		return 0;
+
+	xdev->ff_report = devm_kzalloc(&hdev->dev, sizeof(*xdev->ff_report),
+				       GFP_KERNEL);
+	if (!xdev->ff_report)
+		return -ENOMEM;
+
+	input_set_capability(input, EV_FF, FF_RUMBLE);
+	return input_ff_create_memless(input, NULL, xbox_play_effect);
+}
+
+static int xbox_probe(struct hid_device *hdev, const struct hid_device_id *id)
+{
+	struct xbox_device *xdev;
+	int ret;
+
+	xdev = devm_kzalloc(&hdev->dev, sizeof(*xdev), GFP_KERNEL);
+	if (!xdev)
+		return -ENOMEM;
+
+	xdev->hdev = hdev;
+	INIT_DELAYED_WORK(&xdev->ff_worker, xbox_ff_worker);
+	xdev->ff_next = jiffies;
+	hid_set_drvdata(hdev, xdev);
+
+	ret = hid_parse(hdev);
+	if (ret) {
+		hid_err(hdev, "parse failed\n");
+		return ret;
+	}
+
+	if (xbox_has_input_usage(hdev, HID_UP_CONSUMER | 0x224))
+		xdev->quirks |= XBOX_QUIRK_CONSUMER_BUTTONS;
+
+	ret = hid_hw_start(hdev, HID_CONNECT_DEFAULT);
+	if (ret) {
+		hid_err(hdev, "hw start failed\n");
+		return ret;
+	}
+
+	return 0;
+}
+
+static void xbox_remove(struct hid_device *hdev)
+{
+	struct xbox_device *xdev = hid_get_drvdata(hdev);
+
+	hid_hw_stop(hdev);
+
+	/*
+	 * hid_hw_stop() tears down the input device and with it the
+	 * ff-memless timer, so no new rumble work can be queued past this
+	 * point. Flush anything still pending before devres frees xdev.
+	 */
+	cancel_delayed_work_sync(&xdev->ff_worker);
+}
+
+static const struct hid_device_id xbox_devices[] = {
+	{ HID_BLUETOOTH_DEVICE(USB_VENDOR_ID_MICROSOFT,
+			       USB_DEVICE_ID_MS_XBOX_CONTROLLER_MODEL_1708) },
+	{ HID_BLUETOOTH_DEVICE(USB_VENDOR_ID_MICROSOFT,
+			       USB_DEVICE_ID_MS_XBOX_CONTROLLER_MODEL_1708_BLE) },
+	{ HID_BLUETOOTH_DEVICE(USB_VENDOR_ID_MICROSOFT,
+			       USB_DEVICE_ID_MS_XBOX_CONTROLLER_MODEL_1914) },
+	{ HID_BLUETOOTH_DEVICE(USB_VENDOR_ID_MICROSOFT,
+			       USB_DEVICE_ID_MS_XBOX_CONTROLLER_MODEL_1797) },
+	{ HID_BLUETOOTH_DEVICE(USB_VENDOR_ID_MICROSOFT,
+			       USB_DEVICE_ID_MS_XBOX_CONTROLLER_MODEL_1797_BLE) },
+	{ HID_BLUETOOTH_DEVICE(USB_VENDOR_ID_MICROSOFT,
+			       USB_DEVICE_ID_8BITDO_SN30_PRO_PLUS) },
+	{ }
+};
+MODULE_DEVICE_TABLE(hid, xbox_devices);
+
+static struct hid_driver xbox_driver = {
+	.name = "xbox",
+	.id_table = xbox_devices,
+	.event = xbox_event,
+	.input_configured = xbox_input_configured,
+	.probe = xbox_probe,
+	.remove = xbox_remove,
+};
+module_hid_driver(xbox_driver);
+
+MODULE_DESCRIPTION("HID driver for Xbox Wireless Controllers over Bluetooth");
+MODULE_LICENSE("GPL");
