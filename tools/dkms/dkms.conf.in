PACKAGE_NAME="hid-xbox"
PACKAGE_VERSION="@VERSION@"
MAKE[0]="make KVER=${kernelver}"
CLEAN="make clean"
# hid-microsoft must be replaced too: the stock one still claims the Xbox
# controller IDs. DKMS installs into updates/dkms, which depmod prefers
# over the in-tree copies.
BUILT_MODULE_NAME[0]="hid-xbox"
DEST_MODULE_LOCATION[0]="/updates/dkms"
BUILT_MODULE_NAME[1]="hid-microsoft"
DEST_MODULE_LOCATION[1]="/updates/dkms"
AUTOINSTALL="yes"
